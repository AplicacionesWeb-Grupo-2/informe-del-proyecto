@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram - ColdTrace
caption C4 level 1 for the ColdTrace web application.

LAYOUT_WITH_LEGEND()
LAYOUT_TOP_DOWN()

' Main actors aligned with the user stories from the Web Applications project.
Person(visitor, "Visitor", "Potential user who reviews the landing page, features, plans, and requests a demo [US01-US06].")
Person(owner, "Business Owner or Store Manager", "Monitors refrigerated assets, reviews readings, and handles alerts and incidents from the web application [US18-US28].")
Person(ops, "Operations / Quality / Logistics Manager", "Manages assets, sensors, gateways, ranges, maintenance, reports, and compliance evidence [US12-US17, US29-US38].")
Person(admin, "Organization Administrator", "Manages account data, profile, permissions, and operational settings [US07-US11, US35-US36].")
Person_Ext(auditor, "Health Inspector / External Reviewer", "Receives reports, logs, and exportable evidence for DIGESA/MINSA reviews or internal audits [US31-US34].")

' Main system.
System(coldtrace, "ColdTrace", "Web SaaS system for cold-chain monitoring. Integrates the landing page, web application, internal services, account access, infrastructure, monitoring, alerts, reports, and audit.")

' External systems.
System_Ext(iot, "IoT Devices and Edge Gateways", "Devices installed in cold rooms, warehouses, and transport units. They capture temperature, humidity, and connectivity status [US14-US23].")
System_Ext(email, "Email Service", "External provider for password recovery, commercial confirmations, and alerts [US04, US10, US25].")
System_Ext(push, "Push Notification Service", "External provider for real-time browser and mobile critical alerts [US25-US26].")
System_Ext(messaging, "Messaging Service", "External messaging channel such as WhatsApp Business API or SMS for critical alerts and escalation [US25-US26].")
System_Ext(payments, "Payment Gateway", "External processor for SaaS subscription payments and plan activation.")

' Relationships between actors and the system.
Rel(visitor, coldtrace, "Reviews value proposition and plans, then sends demo request", "HTTPS")
Rel(owner, coldtrace, "Reviews dashboard, history, alerts, and incidents", "HTTPS / Responsive web")
Rel(ops, coldtrace, "Registers assets, configures sensors, monitors, and generates reports", "HTTPS / Web")
Rel(admin, coldtrace, "Manages account, profile, permissions, and operating ranges", "HTTPS / Web")
Rel(coldtrace, auditor, "Provides reports, logs, and compliance evidence", "PDF / CSV")

' Relationships with IoT infrastructure.
Rel(iot, coldtrace, "Sends readings, connectivity status, and synchronized data", "MQTT / HTTP")
Rel(coldtrace, iot, "Applies pairing, ranges, and operating intervals", "API / configuration")

' Relationships with external services.
Rel(coldtrace, email, "Sends password recovery, confirmations, and alerts", "SMTP / REST API")
Rel(coldtrace, push, "Triggers real-time critical alerts and escalation", "Web Push / FCM")
Rel(coldtrace, messaging, "Sends critical alerts through messaging channels", "REST API")
Rel(coldtrace, payments, "Processes monthly subscription payments", "REST / HTTPS")

@enduml

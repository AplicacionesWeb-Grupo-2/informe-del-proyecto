@startuml

title ColdTrace - Database Diagram
caption Single logical MySQL database in 3NF. Colors identify the bounded context of each table.

hide circle
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 34
skinparam ranksep 48

' Account & Access

entity "organizations" as organizations #D6EAF8 {
  * id : char(36) <<PK>>
  --
  legal_name : varchar(160) <<NOT NULL>>
  tax_identifier : varchar(20) <<UK, NOT NULL>>
  contact_email : varchar(120) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
}

entity "users" as users #D6EAF8 {
  * id : char(36) <<PK>>
  --
  # organization_id : char(36) <<FK, NOT NULL>>
  email : varchar(120) <<UK, NOT NULL>>
  display_name : varchar(120) <<NOT NULL>>
  password_hash : varchar(255) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  created_at : datetime <<NOT NULL>>
  verified_at : datetime
}

entity "sessions" as sessions #D6EAF8 {
  * id : char(36) <<PK>>
  --
  # user_id : char(36) <<FK, NOT NULL>>
  access_token_hash : varchar(255) <<UK, NOT NULL>>
  created_at : datetime <<NOT NULL>>
  expires_at : datetime <<NOT NULL>>
  revoked_at : datetime
}

entity "roles" as roles #D6EAF8 {
  * id : char(36) <<PK>>
  --
  name : varchar(80) <<UK, NOT NULL>>
  description : varchar(255)
}

entity "permissions" as permissions #D6EAF8 {
  * id : char(36) <<PK>>
  --
  resource : varchar(80) <<NOT NULL>>
  action : varchar(50) <<NOT NULL>>
  --
  UK (resource, action)
}

entity "user_roles" as user_roles #D6EAF8 {
  * # user_id : char(36) <<PK, FK>>
  * # role_id : char(36) <<PK, FK>>
}

entity "role_permissions" as role_permissions #D6EAF8 {
  * # role_id : char(36) <<PK, FK>>
  * # permission_id : char(36) <<PK, FK>>
}

entity "subscription_plans" as subscription_plans #D6EAF8 {
  * id : char(36) <<PK>>
  --
  name : varchar(80) <<UK, NOT NULL>>
  max_assets : int <<NOT NULL>>
  max_users : int <<NOT NULL>>
  monthly_price : decimal(10,2) <<NOT NULL>>
}

entity "subscriptions" as subscriptions #D6EAF8 {
  * id : char(36) <<PK>>
  --
  # organization_id : char(36) <<FK, NOT NULL>>
  # plan_id : char(36) <<FK, NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  starts_at : date <<NOT NULL>>
  ends_at : date
}

entity "payment_records" as payment_records #D6EAF8 {
  * id : char(36) <<PK>>
  --
  # subscription_id : char(36) <<FK, NOT NULL>>
  provider_reference : varchar(120) <<UK, NOT NULL>>
  amount : decimal(10,2) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  paid_at : datetime
}

entity "notification_preferences" as notification_preferences #D6EAF8 {
  * id : char(36) <<PK>>
  --
  # user_id : char(36) <<FK, UK, NOT NULL>>
  quiet_hours_start : time
  quiet_hours_end : time
  minimum_severity : varchar(30) <<NOT NULL>>
}

entity "notification_preference_channels" as notification_preference_channels #D6EAF8 {
  * # preference_id : char(36) <<PK, FK>>
  * channel : varchar(30) <<PK>>
}

' Sensor Management

entity "assets" as assets #FADBD8 {
  * id : char(36) <<PK>>
  --
  # organization_id : char(36) <<FK, NOT NULL>>
  internal_code : varchar(80) <<NOT NULL>>
  name : varchar(120) <<NOT NULL>>
  description : varchar(255)
  type : varchar(40) <<NOT NULL>>
  capacity_value : decimal(10,2)
  capacity_unit : varchar(20)
  status : varchar(30) <<NOT NULL>>
  --
  UK (organization_id, internal_code)
}

entity "asset_locations" as asset_locations #FADBD8 {
  * # asset_id : char(36) <<PK, FK>>
  --
  label : varchar(120)
  address : varchar(255)
  latitude : decimal(10,7)
  longitude : decimal(10,7)
  is_mobile : boolean <<NOT NULL>>
}

entity "edge_gateways" as edge_gateways #FADBD8 {
  * id : char(36) <<PK>>
  --
  organization_id : char(36) <<NOT NULL>>
  serial_number : varchar(100) <<UK, NOT NULL>>
  claim_code : varchar(80) <<UK, NOT NULL>>
  model : varchar(80) <<NOT NULL>>
  protocol : varchar(40) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
}

entity "sensors" as sensors #FADBD8 {
  * id : char(36) <<PK>>
  --
  # asset_id : char(36) <<FK>>
  edge_gateway_id : char(36)
  serial_number : varchar(100) <<UK, NOT NULL>>
  model : varchar(80) <<NOT NULL>>
  type : varchar(40) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  paired_at : datetime
  reading_interval_seconds : int <<NOT NULL>>
}

entity "calibration_records" as calibration_records #FADBD8 {
  * id : char(36) <<PK>>
  --
  # sensor_id : char(36) <<FK, NOT NULL>>
  certificate_code : varchar(100) <<UK, NOT NULL>>
  calibrated_at : date <<NOT NULL>>
  expires_at : date <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
}

entity "operating_parameters" as operating_parameters #FADBD8 {
  * id : char(36) <<PK>>
  --
  # asset_id : char(36) <<FK, UK, NOT NULL>>
  product_category : varchar(120) <<NOT NULL>>
  temperature_min_celsius : decimal(6,2) <<NOT NULL>>
  temperature_max_celsius : decimal(6,2) <<NOT NULL>>
  humidity_min_percentage : decimal(5,2) <<NOT NULL>>
  humidity_max_percentage : decimal(5,2) <<NOT NULL>>
  reading_interval_seconds : int <<NOT NULL>>
  criticality : varchar(30) <<NOT NULL>>
}

entity "maintenance_schedules" as maintenance_schedules #FADBD8 {
  * id : char(36) <<PK>>
  --
  # asset_id : char(36) <<FK, NOT NULL>>
  sensor_id : char(36)
  scheduled_for : date <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  notes : varchar(500)
}

entity "service_tickets" as service_tickets #FADBD8 {
  * id : char(36) <<PK>>
  --
  # asset_id : char(36) <<FK, NOT NULL>>
  requested_by_user_id : char(36) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  opened_at : datetime <<NOT NULL>>
  closed_at : datetime
}

entity "service_interventions" as service_interventions #FADBD8 {
  * id : char(36) <<PK>>
  --
  # ticket_id : char(36) <<FK, NOT NULL>>
  technician_name : varchar(120) <<NOT NULL>>
  description : varchar(500) <<NOT NULL>>
  result : varchar(30) <<NOT NULL>>
  performed_at : datetime <<NOT NULL>>
}

' Monitoring

entity "offline_sync_batches" as offline_sync_batches #D5F5E3 {
  * id : char(36) <<PK>>
  --
  # edge_gateway_id : char(36) <<FK, NOT NULL>>
  received_at : datetime <<NOT NULL>>
  record_count : int <<NOT NULL>>
  discarded_count : int <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
}

entity "measurements" as measurements #D5F5E3 {
  * id : char(36) <<PK>>
  --
  # sensor_id : char(36) <<FK, NOT NULL>>
  # offline_sync_batch_id : char(36) <<FK>>
  kind : varchar(30) <<NOT NULL>>
  value : decimal(10,3) <<NOT NULL>>
  captured_at : datetime <<NOT NULL>>
  received_at : datetime <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
}

entity "range_evaluations" as range_evaluations #D5F5E3 {
  * id : char(36) <<PK>>
  --
  # measurement_id : char(36) <<FK, UK, NOT NULL>>
  result : varchar(30) <<NOT NULL>>
  evaluated_at : datetime <<NOT NULL>>
  reason : varchar(255)
}

entity "connectivity_snapshots" as connectivity_snapshots #D5F5E3 {
  * id : char(36) <<PK>>
  --
  # sensor_id : char(36) <<FK, NOT NULL>>
  edge_gateway_id : char(36) <<NOT NULL>>
  status : varchar(30) <<NOT NULL>>
  checked_at : datetime <<NOT NULL>>
}

' Alerts

entity "alert_rules" as alert_rules #FCF3CF {
  * id : char(36) <<PK>>
  --
  # sensor_id : char(36) <<FK, NOT NULL>>
  alert_type : varchar(40) <<NOT NULL>>
  severity : varchar(30) <<NOT NULL>>
  minimum_duration_seconds : int <<NOT NULL>>

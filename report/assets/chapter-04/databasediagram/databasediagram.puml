' Account & Access relationships
organizations ||--o{ users
users ||--o{ sessions
users ||--o{ user_roles
roles ||--o{ user_roles
roles ||--o{ role_permissions
permissions ||--o{ role_permissions
subscription_plans ||--o{ subscriptions
organizations ||--o{ subscriptions
subscriptions ||--o{ payment_records
users ||--|| notification_preferences
notification_preferences ||--o{ notification_preference_channels

' Sensor Management relationships
organizations ||--o{ assets
assets ||--|| asset_locations
assets ||--o{ sensors
sensors ||--o{ calibration_records
assets ||--o| operating_parameters
assets ||--o{ maintenance_schedules
assets ||--o{ service_tickets
service_tickets ||--o{ service_interventions

' Monitoring relationships
edge_gateways ||--o{ offline_sync_batches
offline_sync_batches ||--o{ measurements
sensors ||--o{ measurements
measurements ||--o| range_evaluations
sensors ||--o{ connectivity_snapshots

' Alerts relationships
sensors ||--o{ alert_rules
organizations ||--o{ escalation_policies
alert_rules ||--o{ alerts
alerts ||--o| thermal_incidents
thermal_incidents ||--o{ corrective_actions
alerts ||--o{ notifications

' Reports relationships
organizations ||--o{ reports
reports ||--o| monthly_reports
reports ||--o| compliance_reports
reports ||--o{ report_exports
organizations ||--o{ daily_logs
daily_logs ||--o{ reading_summaries
daily_logs ||--o{ alert_summaries
daily_logs ||--o{ incident_summaries
users ||--o{ dashboards
dashboards ||--o{ widgets

' Audit relationships
organizations ||--o{ audit_cases
audit_cases ||--|| evidence_packages
compliance_criteria ||--o{ compliance_findings
audit_cases ||--o{ compliance_findings
evidence_packages ||--o{ evidence_items

@enduml
